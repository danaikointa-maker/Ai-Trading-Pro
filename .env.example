# No7 AI Trading Pro — copy to .env and fill in locally.
# NEVER commit .env. Keep this file free of real credentials.

# ---------------------------------------------------------------- runtime
NO7_ENV=development
NO7_HOST=0.0.0.0
NO7_PORT=8000

# simulate = deterministic local feed (default on Linux/CI)
# mt5      = real MetaTrader 5 terminal history (Windows only)
NO7_FEED_MODE=simulate
NO7_DEFAULT_SYMBOL=XAUUSD
NO7_DEFAULT_BROKER=connext-demo
NO7_SIM_SPEED=6

# ---------------------------------------------------------------- storage
NO7_DB_PATH=storage/db/no7.sqlite3
NO7_DATA_DIR=storage/datasets
NO7_MODEL_DIR=storage/models
NO7_BACKTEST_DIR=storage/backtests
NO7_LOG_DIR=storage/logs

# ---------------------------------------------------------------- security
# Generate one: python -c "import secrets;print(secrets.token_urlsafe(48))"
NO7_JWT_SECRET=
NO7_JWT_TTL_MINUTES=720
NO7_DEMO_USER=demo@no7.ai
NO7_DEMO_PASSWORD=no7demo1234

# ---- perimeter (round 18) -------------------------------------------------
# Cross-origin callers allowed to read the API. Empty = same origin only, which is
# what the dashboard needs. "*" works but is reported by /api/system/health.
NO7_CORS_ORIGINS=
# Peers whose X-Forwarded-For / X-Forwarded-Proto are believed (CIDRs). Put your
# reverse proxy here; anything else is ignored, so a client cannot forge its IP.
NO7_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# enforce | report (Content-Security-Policy-Report-Only) | off
NO7_CSP_MODE=enforce
# HSTS is only ever sent when the request really arrived over HTTPS
NO7_HSTS=true
# Terminate TLS inside uvicorn instead of behind nginx/caddy (scripts/run.sh):
# NO7_TLS_CERT=certs/dev.crt
# NO7_TLS_KEY=certs/dev.key

# ---------------------------------------------------------------- alerts (opt-in)
# In-app alerts always work. Outbound needs a token AND an explicit enable.
NO7_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
NO7_TELEGRAM_CHAT_ID=
NO7_LINE_ENABLED=false
LINE_CHANNEL_TOKEN=
NO7_LINE_TARGET_ID=
NO7_WEBHOOK_ENABLED=false
NO7_WEBHOOK_URL=
# Test/local provider that speaks the same protocol (plain HTTP only for private hosts):
# NO7_TELEGRAM_API_BASE=http://127.0.0.1:8099
# NO7_LINE_API_BASE=http://127.0.0.1:8099

# ---------------------------------------------------------------- rate limits
# memory | sqlite | redis. memory is per process: with `uvicorn --workers 4` the
# configured limit is effectively 4x. sqlite shares one budget per host; redis shares
# across hosts (also used by cluster.backend=redis through NO7_REDIS_URL).
NO7_RATELIMIT_STORE=memory
NO7_REDIS_URL=
NO7_RATELIMIT_PREFIX=no7:ratelimit

# Full auto stays OFF unless this is true AND the dashboard toggle is on AND
# the account is demo AND the model passed its out-of-sample gates.
NO7_ALLOW_FULL_AUTO=false

# ---------------------------------------------------------------- MT5 (Windows)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
NO7_MT5_MAGIC=707007

# ---------------------------------------------------------------- notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_NOTIFY_TOKEN=

# ---------------------------------------------------------------- local LLM (optional)
# No7 AI / Ollama for explanations only. The LLM never places orders.
NO7_LLM_URL=http://127.0.0.1:11434
NO7_LLM_MODEL=qwen2.5:7b-instruct
NO7_LLM_ENABLED=false

# ---------------------------------------------------------------- dashboard dev
# Only used by `npm run dev`; the production bundle is served by FastAPI.
NO7_BACKEND=http://127.0.0.1:8000
