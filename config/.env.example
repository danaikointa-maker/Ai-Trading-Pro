# ---------------------------------------------------------------------------
# No7 AI Trading Pro V1 — environment template
# Copy to .env (never commit .env). All paths are RELATIVE to NO7_ROOT so the
# project can move from C:\ to D:\ without touching source code.
# ---------------------------------------------------------------------------
NO7_ROOT=.
NO7_ENV=development

# --- Database / storage roots (single source of truth) ---
NO7_DB_PATH=storage/db/no7.sqlite3
NO7_DATA_DIR=storage/datasets
NO7_MODEL_DIR=storage/models
NO7_BACKTEST_DIR=storage/backtests
NO7_LOG_DIR=storage/logs

# --- Auth (required in production; a dev default is generated if unset) ---
NO7_JWT_SECRET=change-me-to-a-long-random-string
NO7_JWT_TTL_MINUTES=720
NO7_DEMO_USER=demo@no7.ai
NO7_DEMO_PASSWORD=no7demo1234

# --- Market data ---
# feed_mode: simulate (default, no MT5 needed) | mt5 (reads live terminal)
NO7_FEED_MODE=simulate
NO7_SIM_SEED=7
NO7_SIM_SPEED=1.0          # simulated minutes per second
NO7_SIM_BARS=20000         # M1 history bars bootstrapped at startup

# --- MT5 bridge (Windows host only) ---
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Connext-Demo
MT5_TIMEOUT_MS=5000

# --- No7 Local AI (Ollama) for the trade explainer ---
NO7_LOCAL_AI_URL=http://127.0.0.1:11434
NO7_LOCAL_AI_MODEL=no7-local
NO7_LOCAL_AI_ENABLED=false

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_CHANNEL_TOKEN=
LINE_TARGET_ID=

# --- Hard safety switch: must stay false unless a human flips it on a demo ---
NO7_ALLOW_FULL_AUTO=false
